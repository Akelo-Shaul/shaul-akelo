# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents the required vars.
!.env.example

# The raw 230MB Blender export. Exceeds GitHub's 100MB hard limit and nothing loads
# it — Room.tsx uses room-optimized.glb (28MB), which IS tracked. Keep the source
# locally, just never commit it.
public/models/room.glb

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
