# Copy to `.env.local` for local development, and set the same keys in
# Vercel > Settings > Environment Variables for production. `.env.local` is gitignored.
#
# Used by src/app/api/quote/route.ts (the "Get a quote" drawer).

# Resend API key. Without it the quote form still works and returns success, but submissions are
# only logged to the server console instead of emailed.
RESEND_API_KEY=

# Where quote submissions are delivered. Defaults to shaulakelo@gmail.com if unset.
QUOTE_TO_EMAIL=

# Sender address. `onboarding@resend.dev` is Resend's sandbox sender — no setup, but it can only
# deliver to the address that owns the Resend account. Use an address on a domain you've verified
# in Resend before expecting delivery to anyone else.
QUOTE_FROM_EMAIL=
